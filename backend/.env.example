PORT=3001
# production | development. Production Safety Gate (audit recommendation #1):
# NODE_ENV=production makes DATABASE_URL, NORMOS_API_TOKEN, and
# NORMOS_ADMIN_TOKEN all REQUIRED — any of them missing is a FATAL boot error
# (process exits nonzero; see src/config/checkEnv.js) instead of silently
# falling back to a local DB or serving the API unauthenticated. This only
# applies in production — local dev stays exactly as convenient as before.
NODE_ENV=development
# IANA timezone used for every "today"/schedule calculation across the app
# (briefing lock, scheduler firing times, etc). Defaults to America/New_York
# if unset.
TZ=America/New_York
# Comma-separated allowlist of browser origins for CORS. The mobile app isn't
# subject to CORS, so this only matters for a browser-based client. Empty =
# default-open (fine for local dev only).
CORS_ORIGINS=

# NormOS data spine (self-hosted Postgres + TimescaleDB + pgvector).
# Matches docker-compose.yml defaults; change credentials for production.
DATABASE_URL=postgres://normos:normos@localhost:5432/normos
# Pool/timeout hardening (all optional — sane defaults if unset). See src/db/index.js.
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
# How long listMetricKeys() caches its full-table DISTINCT scan. See src/store/metrics.js.
# METRIC_KEYS_CACHE_MS=300000
# How long liveRecovery() caches its computed score. See src/intelligence/recovery.js.
# RECOVERY_CACHE_MS=120000
# SERVER_REQUEST_TIMEOUT_MS=180000

# --- AI models ----------------------------------------------------------------
# Chat/reasoning provider: anthropic (Claude — recommended) | gemini.
# Defaults to anthropic when ANTHROPIC_API_KEY is set, else gemini. See
# src/config/checkEnv.js — the app warns loudly at boot (but still starts) if
# neither is actually usable, since chat/voice/the daily briefing all depend
# on one.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Routes clear voice/chat commands (log a habit, swap a workout) to a faster
# model with no extended thinking. Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# The daily chief-brief call specifically (cross-domain synthesis over body/
# money/focus/calendar/inbox) — independent of ANTHROPIC_MODEL so the
# lighter calls (wisdom, context-adjust, habit parsing) can stay on a cheaper
# tier while the one call that most benefits from a stronger reasoner uses
# it. At once-or-twice-a-day call volume the price difference between tiers
# is cents, so this defaults to the strongest available model.
ANTHROPIC_CHIEF_MODEL=claude-opus-4-8
# Reasoning depth (output_config.effort) for the chief-brief call specifically
# — low | medium | high | xhigh | max. Independent of any other call's effort
# (there isn't one elsewhere yet); 'high' is the strongest setting worth
# defaulting to at this call volume.
ANTHROPIC_CHIEF_EFFORT=high
GEMINI_API_KEY=your_key_here
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=95000
# STT (voice transcription). Short per-attempt timeout — a real transcription
# returns in 1-3s, so a hung/overloaded call should fail fast, not spin. Tries
# GEMINI_STT_MODEL first, then GEMINI_STT_FALLBACK_MODELS (comma-separated) on a
# 503 "model overloaded". Defaults lead with the mature gemini-2.5-flash because
# the newer gemini-3.5-flash was returning consistent 503s; flip these if that
# reverses.
GEMINI_STT_TIMEOUT_MS=12000
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_STT_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_STT_BACKOFF_MS=400
# TTS (spoken narration for Chief Brief / Evening Brief / Wisdom "Listen").
#
# NORMOS_TTS_PROVIDER selects the provider-neutral router's mode
# (services/ttsProvider.js): 'auto' (default) and 'openai' both prefer
# OpenAI's /v1/audio/speech (a mature, non-preview endpoint) with Gemini as
# a bounded fallback; 'gemini' prefers Gemini with OpenAI as the fallback.
# An unrecognized value falls back to 'auto'. This was added after
# production evidence that Gemini's PREVIEW TTS models
# (gemini-2.5-flash-preview-tts / gemini-2.5-pro-preview-tts) intermittently
# stall for the full per-attempt timeout on a real (not trivial) script —
# see GET /api/diag/tts for a live probe of both providers.
NORMOS_TTS_PROVIDER=auto
# OpenAI TTS config — reuses the SAME OPENAI_API_KEY already configured
# below for Realtime voice mode; no separate secret needed.
# OPENAI_TTS_MODEL: gpt-4o-mini-tts is preferred (current-generation,
# higher quality); fall back to tts-1 if your project doesn't have access.
# OPENAI_TTS_VOICE: one of OpenAI's built-in voices (alloy, echo, fable,
# onyx, nova, shimmer, and newer ones like ash/ballad/coral/sage/verse).
# OPENAI_TTS_FORMAT: wav (default — matches Gemini's existing wire format,
# no mobile client change needed), or mp3/aac/flac/opus for a smaller
# payload (mobile/src/lib/voice.ts picks the right file extension either
# way). OPENAI_TTS_TIMEOUT_MS is this provider's own per-attempt ceiling —
# the router (TTS_OVERALL_TIMEOUT_MS below) may hand it less than this if
# little of the overall deadline remains.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=wav
OPENAI_TTS_TIMEOUT_MS=12000
# The ONE bounded end-to-end deadline for the router's whole
# provider-fallback sequence (services/ttsProvider.js) — must stay
# comfortably under the mobile client's own fetch timeout
# (useBriefAudio.ts's DEFAULT_TIMEOUT_MS, 55000ms) so the server can return
# a clean error/success before the client gives up, not race it. Split
# across however many provider candidates remain (see
# computeProviderBudget) — never the full per-provider timeout serially for
# every candidate.
TTS_OVERALL_TIMEOUT_MS=40000
#
# GEMINI_TTS_MODEL is an OPTIONAL override, tried FIRST ahead of every
# built-in Gemini fallback (services/voice.js's TTS_CANDIDATES) — it MUST be
# an actual TTS-capable model id (contains "tts"). Live production bug: this
# was mistakenly set to gemini-3.5-flash (a plain text model, reused from
# GEMINI_CHAT_MODEL above) — since the override is always tried first, EVERY
# narration call failed regardless of the built-in fallback list. A second
# live bug: gemini-3.1-flash-tts-preview was set here and HUNG on every call
# (a ~25s timeout, not a fast error) — it is deliberately excluded from the
# built-in candidates for that reason; do not set this to it. Leave unset to
# use the built-in candidates directly.
GEMINI_TTS_MODEL=
# Per-model-attempt timeout. Real failures (bad/retired model id) return in
# well under a second, so this is mostly a hang guard, not a normal wait —
# do NOT set this to a few seconds in production; a too-short timeout can
# cut off a genuinely slow (not hung) model before it finishes.
GEMINI_TTS_TIMEOUT_MS=25000
# The bounded end-to-end deadline for Gemini's OWN model-fallback retry loop
# (services/voice.js) when Gemini runs as primary; when Gemini runs as the
# router's fallback (see TTS_OVERALL_TIMEOUT_MS above) it may get less than
# this if little of the shared deadline remains.
GEMINI_TTS_OVERALL_TIMEOUT_MS=45000
# Embeddings provider (must be 768-dim to match the schema): gemini.
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_EMBED_CONCURRENCY=8
# Spoken-briefing voice. NORMOS_VOICE is a Gemini prebuilt voice name
# (default 'Orus'); NORMOS_VOICE_STYLE is a free-text style directive.
NORMOS_VOICE=
NORMOS_VOICE_STYLE=
# --------------------------------------------------------------------------------

NOTION_API_KEY=your_key_here
NOTION_PAGE_ID=7c43faa67b284b8a900a3c98545e01b5
# Optional: dedicated page for the "quote of the day" feature. Only read if
# set — there is no fallback to NOTION_PAGE_ID in code.
NOTION_QUOTES_PAGE_ID=
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DOC_ID=1nut0jXBKyK6nWTdfwRDwkkcq0_DejXSCW97UgbFUVtc
# Optional: a work calendar (distinct from your primary) whose busy blocks
# feed the briefing's meeting-load framing. Unset = that signal is skipped.
GOOGLE_WORK_CALENDAR_ID=

# WeatherKit (Apple Developer required) — OR use OpenWeatherMap below
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY_PATH=

# Alternative: OpenWeatherMap
OPENWEATHER_API_KEY=
WEATHER_LAT=your_lat
WEATHER_LON=your_lon
# How long a fetched weather reading is served from cache before refreshing.
WEATHER_CACHE_MS=600000

# --- NormOS connectors -----------------------------------------------------

# Readwise (Learning): https://readwise.io/access_token
READWISE_TOKEN=

# Wealth (primary): Monarch CSV import. Export from Monarch (Settings → Data →
# Download) and drop the file(s) into the folder below, then `npm run ingest`.
# No keys needed. Defaults to backend/imports/monarch/ if unset.
MONARCH_IMPORT_DIR=
# Wealth (optional, richer): Monarch's own login, for the direct API path —
# NOT the same as the MCP path below. Dormant unless both are set.
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_DEVICE_UUID=
# Wealth (optional, most complete): Monarch's MCP server — live budget/
# recurring-bill data the CSV export doesn't carry. See
# scripts/get-monarch-mcp-token.js to obtain MONARCH_MCP_REFRESH_TOKEN.
MONARCH_MCP_URL=https://api.monarch.com/mcp
MONARCH_MCP_CLIENT_ID=
MONARCH_MCP_CLIENT_SECRET=
MONARCH_MCP_REFRESH_TOKEN=
MONARCH_MCP_PROTOCOL_VERSION=2025-11-25
MONARCH_MCP_TIMEOUT_MS=30000
MONARCH_OAUTH_BASE=https://api.monarch.com
# Only used by the one-off scripts/get-monarch-mcp-token.js OAuth helper.
MONARCH_OAUTH_CALLBACK_PORT=8723
# Rarely-used token/tuning overrides:
MONARCH_TOKEN=
MONARCH_LOOKBACK_DAYS=35
MONARCH_WEALTH_CACHE_MS=180000
# Comma-separated category/account names to exclude from spend/income analysis
# (internal transfers, card payments, etc — avoids double-counting).
MONARCH_EXCLUDE_ACCOUNTS=
MONARCH_EXCLUDE_INCOME_CATEGORIES=
MONARCH_FIXED_CATEGORIES=
MONARCH_TRANSFER_CATEGORIES=
# Per-account 401k lookup for /api/wealth/snapshot's `retirement` field — the
# exact account name from your Monarch balance export (e.g. "Fidelity 401k").
MONARCH_401K_ACCOUNT=

# Eight Sleep (Recovery/HRV) — optional; the recovery card falls back to
# self-reported sleep when unset. Sets both the connector's login AND the
# scheduler's overnight polling window + sleep-readiness gate.
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=
EIGHT_SLEEP_POLL_MIN=6
EIGHT_SLEEP_POLL_START_HOUR=6
EIGHT_SLEEP_POLL_START_MINUTE=30
# Give-up hour: after this local time, stop trying to build for the day and
# leave the brief UNBUILT rather than force-building an unfinalized night. There
# is no force-build backstop — a late/missing brief beats an early one that
# wakes you.
EIGHT_SLEEP_GIVEUP_HOUR=12
EIGHT_SLEEP_GIVEUP_MINUTE=0
# Readiness gate tuning: how many consecutive polls must show the SAME finalized
# sleep snapshot, the minimum age of that unchanged snapshot, and (when the API
# provides presenceEnd) the minimum age of that presence-end timestamp.
EIGHT_SLEEP_MIN_OBSERVATIONS=2
EIGHT_SLEEP_STABILITY_MIN_MIN=10
EIGHT_SLEEP_TELEMETRY_MIN_MIN=12

# Plaid (Wealth) — OPTIONAL / dormant. Monarch is the primary wealth source, so
# Plaid is not registered by default (avoids double-counting net worth). Only
# fill these in and re-register the connector if you want intra-month freshness.
# https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# One access_token per linked institution, comma-separated (obtained via Plaid Link).
PLAID_ACCESS_TOKENS=

# --- Scheduler (the self-running morning/evening routine) ------------------
# The scheduler itself is OFF by default — set true to enable it (a cloud
# deploy that should run unattended; local dev usually triggers routes by hand).
ENABLE_SCHEDULER=false
# CRON_SECRET gates POST /api/cron/morning and /api/cron/weekly (an external
# cron host hitting the API directly instead of relying on the in-process
# scheduler, which resets its timers on every restart/redeploy).
CRON_SECRET=
# All times are HOUR/MINUTE pairs in TZ, 24h clock. Defaults shown.
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=30
CHECKIN_REMINDER_HOUR=15
CHECKIN_REMINDER_MINUTE=0
ANALYZE_EVENING_HOUR=21
ANALYZE_EVENING_MINUTE=30
# Combined evening reminder — one push covering check-in/habits/day-context,
# whichever are still open (previously three separate pushes at :00/:00/:05).
EVENING_REMINDER_HOUR=21
EVENING_REMINDER_MINUTE=0
# Commitments (follow-through reminders) poll cadence + nag limits.
COMMITMENT_POLL_MIN=2
COMMITMENT_MAX_PER_DAY=4
COMMITMENT_RENUDGE_HOURS=3
COMMITMENT_MAX_REMINDERS=2
COMMITMENT_STALE_HOURS=24
# Attention Policy (the shared judgment layer that decides whether/how a
# detected signal reaches you — see docs/ARCHITECTURE.md). DAILY_BUDGET caps
# how many DIFFERENT facts may push per day; CRITICAL_RESERVE is a small,
# separate allowance only spendable by allowlisted critical health anomalies.
ATTENTION_DAILY_BUDGET=4
ATTENTION_CRITICAL_RESERVE=1
# Atomic delivery (reserve -> push -> finalize). A reserved slot whose finalize
# never ran (process crash mid-push) is reclaimed after this TTL. A failed push
# is retried on the next dispatch cycle, capped per fact per day so a
# persistently-failing push can't re-fire every run.
ATTENTION_RESERVATION_TTL_MS=600000
ATTENTION_MAX_DELIVERY_ATTEMPTS=3

# Talk to NormOS — OpenAI Realtime voice mode (see docs/ARCHITECTURE.md). The
# mobile client connects directly to OpenAI over WebRTC using a short-lived
# secret minted here; OPENAI_API_KEY never reaches the client, and provider
# error messages are scrubbed of key fragments before any response/log
# (services/realtime.js redactKeyFragments).
# SECURITY: if this key is ever exposed — pasted into a chat, committed, or
# printed to a log — REVOKE AND ROTATE it immediately in the OpenAI dashboard.
# The app only reads it from this env var, so rotating requires no code change.
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=cedar
# Input-speech transcription model for the live voice transcript + turn
# persistence (Realtime input transcription is off unless this is set).
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Kill switch — set to 'false' to force every client back onto the old
# Gemini push-to-talk path without a redeploy (e.g. if Realtime misbehaves).
VOICE_REALTIME_ENABLED=true

# --- Briefing build tuning (all optional — sane defaults if unset) ---------
BRIEFING_CACHE_MIN=180
# Must clear the Anthropic provider's own per-call timeout (110000ms, see
# src/llm/providers/anthropic.js) with headroom, or this outer withTimeout()
# race abandons a legitimately-finishing chief-brief call before it returns —
# wasted cost, and the user gets a stale/fallback brief for nothing. The
# chief-brief call now runs Opus 4.8 with extended thinking (see
# ANTHROPIC_CHIEF_MODEL below), which makes it materially more likely to run
# long than the old fast/no-thinking path this default was originally sized for.
BRIEFING_LLM_TIMEOUT_MS=130000
BRIEFING_SOURCE_TIMEOUT_MS=12000
EMAIL_PROMPT_CHARS=15000
EMAIL_PROMPT_TOTAL=200000
# Estimated-calorie baseline (lbs) for watch-off activity estimates.
ACTIVITY_EST_WEIGHT_LB=

# One-setting demo data: set true to populate realistic sample data +
# findings so the app shows a full dashboard on first open. Idempotent
# (only touches 'seed' rows); turn back off once real data flows.
SEED_DEMO_ON_BOOT=false

# API auth — set to require Authorization: Bearer <token> on /api (except
# /api/health). Leave empty for local use. REQUIRED when NODE_ENV=production
# (Production Safety Gate, audit recommendation #1) — the server refuses to
# boot without it, and the general /api gate fails CLOSED (503) rather than
# open if it's ever unset at runtime. Put the same value in
# mobile/src/config.ts API_TOKEN.
NORMOS_API_TOKEN=

# Separate token gating /api/diag/*, /api/debug/*, /api/admin/reset-demo,
# /api/admin/recompute-wealth, and /api/ingest/run — these are powerful
# (reset-demo deletes data) or expose internal state, so they don't accept
# NORMOS_API_TOKEN even if set. Set this to something different from
# NORMOS_API_TOKEN and keep it off the mobile client entirely — you'll curl
# these by hand when troubleshooting. See src/middleware/adminAuth.js.
# REQUIRED when NODE_ENV=production, same as NORMOS_API_TOKEN above — the
# server refuses to boot without it.
NORMOS_ADMIN_TOKEN=
