PORT=3001
# production | development. Controls a few things: NODE_ENV=production makes
# DATABASE_URL missing a FATAL boot error (see src/config/checkEnv.js)
# instead of silently falling back to a local DB, and makes an unset
# NORMOS_API_TOKEN/NORMOS_ADMIN_TOKEN log loudly instead of just a warning.
NODE_ENV=development
# IANA timezone used for every "today"/schedule calculation across the app
# (briefing lock, scheduler firing times, etc). Defaults to America/New_York
# if unset.
TZ=America/New_York
# Comma-separated allowlist of browser origins for CORS. The mobile app isn't
# subject to CORS, so this only matters for a browser-based client. Empty =
# default-open (fine for local dev only).
CORS_ORIGINS=

# NormOS data spine (self-hosted Postgres + TimescaleDB + pgvector).
# Matches docker-compose.yml defaults; change credentials for production.
DATABASE_URL=postgres://normos:normos@localhost:5432/normos
# Pool/timeout hardening (all optional — sane defaults if unset). See src/db/index.js.
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
# How long listMetricKeys() caches its full-table DISTINCT scan. See src/store/metrics.js.
# METRIC_KEYS_CACHE_MS=300000
# How long liveRecovery() caches its computed score. See src/intelligence/recovery.js.
# RECOVERY_CACHE_MS=120000
# SERVER_REQUEST_TIMEOUT_MS=150000

# --- AI models ----------------------------------------------------------------
# Chat/reasoning provider: anthropic (Claude — recommended) | gemini.
# Defaults to anthropic when ANTHROPIC_API_KEY is set, else gemini. See
# src/config/checkEnv.js — the app warns loudly at boot (but still starts) if
# neither is actually usable, since chat/voice/the daily briefing all depend
# on one.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Routes clear voice/chat commands (log a habit, swap a workout) to a faster
# model with no extended thinking. Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=your_key_here
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=95000
GEMINI_STT_TIMEOUT_MS=45000
GEMINI_TTS_MODEL=
GEMINI_TTS_TIMEOUT_MS=60000
# Embeddings provider (must be 768-dim to match the schema): gemini.
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_EMBED_CONCURRENCY=8
# Spoken-briefing voice. NORMOS_VOICE is a Gemini prebuilt voice name
# (default 'Orus'); NORMOS_VOICE_STYLE is a free-text style directive.
NORMOS_VOICE=
NORMOS_VOICE_STYLE=
# --------------------------------------------------------------------------------

NOTION_API_KEY=your_key_here
NOTION_PAGE_ID=7c43faa67b284b8a900a3c98545e01b5
# Optional: dedicated page for the "quote of the day" feature. Only read if
# set — there is no fallback to NOTION_PAGE_ID in code.
NOTION_QUOTES_PAGE_ID=
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DOC_ID=1nut0jXBKyK6nWTdfwRDwkkcq0_DejXSCW97UgbFUVtc
# Optional: a work calendar (distinct from your primary) whose busy blocks
# feed the briefing's meeting-load framing. Unset = that signal is skipped.
GOOGLE_WORK_CALENDAR_ID=

# WeatherKit (Apple Developer required) — OR use OpenWeatherMap below
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY_PATH=

# Alternative: OpenWeatherMap
OPENWEATHER_API_KEY=
WEATHER_LAT=your_lat
WEATHER_LON=your_lon
# How long a fetched weather reading is served from cache before refreshing.
WEATHER_CACHE_MS=600000

# --- NormOS connectors -----------------------------------------------------

# Readwise (Learning): https://readwise.io/access_token
READWISE_TOKEN=

# Wealth (primary): Monarch CSV import. Export from Monarch (Settings → Data →
# Download) and drop the file(s) into the folder below, then `npm run ingest`.
# No keys needed. Defaults to backend/imports/monarch/ if unset.
MONARCH_IMPORT_DIR=
# Wealth (optional, richer): Monarch's own login, for the direct API path —
# NOT the same as the MCP path below. Dormant unless both are set.
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_DEVICE_UUID=
# Wealth (optional, most complete): Monarch's MCP server — live budget/
# recurring-bill data the CSV export doesn't carry. See
# scripts/get-monarch-mcp-token.js to obtain MONARCH_MCP_REFRESH_TOKEN.
MONARCH_MCP_URL=https://api.monarch.com/mcp
MONARCH_MCP_CLIENT_ID=
MONARCH_MCP_CLIENT_SECRET=
MONARCH_MCP_REFRESH_TOKEN=
MONARCH_MCP_PROTOCOL_VERSION=2025-11-25
MONARCH_MCP_TIMEOUT_MS=30000
MONARCH_OAUTH_BASE=https://api.monarch.com
# Only used by the one-off scripts/get-monarch-mcp-token.js OAuth helper.
MONARCH_OAUTH_CALLBACK_PORT=8723
# Rarely-used token/tuning overrides:
MONARCH_TOKEN=
MONARCH_LOOKBACK_DAYS=35
MONARCH_WEALTH_CACHE_MS=180000
# Comma-separated category/account names to exclude from spend/income analysis
# (internal transfers, card payments, etc — avoids double-counting).
MONARCH_EXCLUDE_ACCOUNTS=
MONARCH_EXCLUDE_INCOME_CATEGORIES=
MONARCH_FIXED_CATEGORIES=
MONARCH_TRANSFER_CATEGORIES=
# Per-account 401k lookup for /api/wealth/snapshot's `retirement` field — the
# exact account name from your Monarch balance export (e.g. "Fidelity 401k").
MONARCH_401K_ACCOUNT=

# Eight Sleep (Recovery/HRV) — optional; the recovery card falls back to
# self-reported sleep when unset. Sets both the connector's login AND the
# scheduler's overnight polling window.
EIGHT_SLEEP_EMAIL=
EIGHT_SLEEP_PASSWORD=
EIGHT_SLEEP_POLL_MIN=6
EIGHT_SLEEP_POLL_START_HOUR=6
EIGHT_SLEEP_POLL_START_MINUTE=30
EIGHT_SLEEP_BACKSTOP_HOUR=10
EIGHT_SLEEP_BACKSTOP_MINUTE=0
EIGHT_SLEEP_MIN_WAKE_HOUR=7.5
EIGHT_SLEEP_WAKE_BUFFER_MIN=12

# Plaid (Wealth) — OPTIONAL / dormant. Monarch is the primary wealth source, so
# Plaid is not registered by default (avoids double-counting net worth). Only
# fill these in and re-register the connector if you want intra-month freshness.
# https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# One access_token per linked institution, comma-separated (obtained via Plaid Link).
PLAID_ACCESS_TOKENS=

# --- Scheduler (the self-running morning/evening routine) ------------------
# The scheduler itself is OFF by default — set true to enable it (a cloud
# deploy that should run unattended; local dev usually triggers routes by hand).
ENABLE_SCHEDULER=false
# CRON_SECRET gates POST /api/cron/morning and /api/cron/weekly (an external
# cron host hitting the API directly instead of relying on the in-process
# scheduler, which resets its timers on every restart/redeploy).
CRON_SECRET=
# All times are HOUR/MINUTE pairs in TZ, 24h clock. Defaults shown.
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=30
CHECKIN_REMINDER_HOUR=15
CHECKIN_REMINDER_MINUTE=0
CHECKIN_EVENING_REMINDER_HOUR=21
CHECKIN_EVENING_REMINDER_MINUTE=0
ANALYZE_EVENING_HOUR=21
ANALYZE_EVENING_MINUTE=30
HABITS_REMINDER_HOUR=21
HABITS_REMINDER_MINUTE=0
DAY_CONTEXT_REMINDER_HOUR=21
DAY_CONTEXT_REMINDER_MINUTE=5
EVENING_BRIEFING_HOUR=18
EVENING_BRIEFING_MINUTE=0
# Commitments (follow-through reminders) poll cadence + nag limits.
COMMITMENT_POLL_MIN=2
COMMITMENT_MAX_PER_DAY=4
COMMITMENT_RENUDGE_HOURS=3
COMMITMENT_MAX_REMINDERS=4
COMMITMENT_STALE_HOURS=24

# --- Briefing build tuning (all optional — sane defaults if unset) ---------
BRIEFING_CACHE_MIN=180
BRIEFING_LLM_TIMEOUT_MS=90000
BRIEFING_SOURCE_TIMEOUT_MS=12000
BRIEFING_FRESH_SKIP_MS=
EMAIL_PROMPT_CHARS=15000
EMAIL_PROMPT_TOTAL=200000
# Estimated-calorie baseline (lbs) for watch-off activity estimates.
ACTIVITY_EST_WEIGHT_LB=

# One-setting demo data: set true to populate realistic sample data +
# findings so the app shows a full dashboard on first open. Idempotent
# (only touches 'seed' rows); turn back off once real data flows.
SEED_DEMO_ON_BOOT=false

# Optional API auth — set to require Authorization: Bearer <token> on /api
# (except /api/health). Leave empty for local use; set it if hosting on a VPS,
# and put the same value in mobile/src/config.ts API_TOKEN.
NORMOS_API_TOKEN=

# Separate token gating /api/diag/*, /api/debug/*, /api/admin/reset-demo,
# /api/admin/recompute-wealth, and /api/ingest/run — these are powerful
# (reset-demo deletes data) or expose internal state, so they don't accept
# NORMOS_API_TOKEN even if set. If hosting publicly, set this to something
# different from NORMOS_API_TOKEN and keep it off the mobile client entirely —
# you'll curl these by hand when troubleshooting. See src/middleware/adminAuth.js.
NORMOS_ADMIN_TOKEN=
