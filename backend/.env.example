PORT=3001

# NormOS data spine (self-hosted Postgres + TimescaleDB + pgvector).
# Matches docker-compose.yml defaults; change credentials for production.
DATABASE_URL=postgres://normos:normos@localhost:5432/normos

# --- AI models ----------------------------------------------------------------
# Reasoning/chat provider: anthropic (Claude — recommended) | gemini | ollama.
# Defaults to Claude when ANTHROPIC_API_KEY is set, else Gemini.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Latest Claude (defaults to claude-sonnet-4-6). Use an Opus id for deep reviews.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Latest Gemini chat model (defaults to gemini-3.1). If Google's API expects a
# fuller id (e.g. gemini-3.1-pro), set it here — no code change needed.
GEMINI_CHAT_MODEL=gemini-3.1
# Embeddings provider (must be 768-dim): gemini | ollama.
EMBED_PROVIDER=
# --------------------------------------------------------------------------------

GEMINI_API_KEY=your_key_here
NOTION_API_KEY=your_key_here
NOTION_PAGE_ID=7c43faa67b284b8a900a3c98545e01b5
# Optional: dedicated parent page of "wisdom" sub-pages for the learning connector.
# Defaults to NOTION_PAGE_ID if unset.
NOTION_WISDOM_PAGE_ID=
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DOC_ID=1nut0jXBKyK6nWTdfwRDwkkcq0_DejXSCW97UgbFUVtc

# WeatherKit (Apple Developer required) — OR use OpenWeatherMap below
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY_PATH=

# Alternative: OpenWeatherMap
OPENWEATHER_API_KEY=
WEATHER_LAT=your_lat
WEATHER_LON=your_lon

# --- NormOS LLM layer ------------------------------------------------------
# Chat/reasoning provider: anthropic | gemini | ollama
# (defaults to anthropic if ANTHROPIC_API_KEY is set, else gemini)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_CHAT_MODEL=gemini-1.5-flash
# Embeddings provider: gemini | ollama (must be 768-dim to match the schema)
EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=text-embedding-004
# Local, private option — your data never leaves the machine:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- NormOS connectors -----------------------------------------------------

# Readwise (Learning): https://readwise.io/access_token
READWISE_TOKEN=

# Wealth (primary): Monarch CSV import. Export from Monarch (Settings → Data →
# Download) and drop the file(s) into the folder below, then `npm run ingest`.
# No keys needed. Defaults to backend/imports/monarch/ if unset.
MONARCH_IMPORT_DIR=

# Plaid (Wealth) — OPTIONAL / dormant. Monarch is the primary wealth source, so
# Plaid is not registered by default (avoids double-counting net worth). Only
# fill these in and re-register the connector if you want intra-month freshness.
# https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# One access_token per linked institution, comma-separated (obtained via Plaid Link).
PLAID_ACCESS_TOKENS=
